# Lingorm Map — 本地開發環境變數
# 複製這個檔案為 .env，填入真實值，然後執行：
#   source .env && bash build.sh
#
# ⚠️  .env 已在 .gitignore 中，不會被 commit

# Google Maps JS API key（Google Cloud Console → Credentials）
# 主要 provider，無此 key 時直接使用 HERE
GOOGLE_MAPS_KEY=your_google_maps_key_here

# Google Maps Map ID（Cloud Console → Map management）
GOOGLE_MAP_ID=your_google_map_id_here

# HERE Maps JS API key（developer.here.com → Projects → REST API key）
# Google Maps 超限時的 fallback provider
HERE_API_KEY=your_here_api_key_here

# Google Places API server key（只供本機檢核工具使用，不可放進前端）
GOOGLE_PLACE_KEY=your_google_places_server_key_here

# Notion internal integration token — the sole Notion credential.
# 2026-07-21：「Locations (PoC)」檢核工作台已刪除，現在只有一個正式 Locations
# database。這把 key 同時具備 read + write 權限，供 location:verify、
# location:verify:ui、locations:export:notion 等全部工具使用（讀取、驗證、
# candidate/review/apply 寫入）。NOTION_FORMAL_READ_API_KEY 與
# NOTION_FORMAL_WRITE_API_KEY 這兩把已隨 PoC 一併退役，不再需要設定。
NOTION_API_KEY=your_notion_integration_token_here

# 地點資料來源：目前只支援 notion（已提交並驗證的 data/locations.csv）。
# 2026-07-21 三狀態 cutover 完成後，legacy 的 verified/needs review 等狀態一律
# normalize 為 Paused（非公開），sheet 回滾路徑已停用——設為 sheet 會導致地圖
# 顯示 0 筆地點，不要使用。DATA_SOURCE 未設定時的預設值也是 notion。
DATA_SOURCE=notion

# GOOGLE_SHEET_CSV_URL：sheet 回滾路徑已停用（見上），此變數不再使用，保留僅供歷史對照。
