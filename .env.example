# Lingorm Bangkok Map — 本地開發環境變數
# 複製這個檔案為 .env，填入真實值，然後執行：
#   source .env && bash build.sh
#
# ⚠️  .env 已在 .gitignore 中，不會被 commit

# Google Maps JS API key（Google Cloud Console → Credentials）
GOOGLE_MAPS_KEY=your_api_key_here

# Google Maps Map ID（Cloud Console → Map management）
GOOGLE_MAP_ID=your_map_id_here

# 管理員密碼（選填，用於 #admin 頁面）
# ADMIN_PASSWORD=your_admin_password_here

# Google Sheets 發佈至網路後的 CSV URL
# 只放在 Netlify / 本機環境變數，前端會透過 /api/locations 讀取，不會暴露此網址
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/.../pub?gid=...&single=true&output=csv
