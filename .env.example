# Lingorm Map — 本地開發環境變數
# 複製這個檔案為 .env，填入真實值，然後執行：
#   source .env && bash build.sh
#
# ⚠️  .env 已在 .gitignore 中，不會被 commit

# Google Maps JS API key（Google Cloud Console → Credentials）
# 主要 provider，無此 key 時直接使用 HERE
GOOGLE_MAPS_KEY=your_google_maps_key_here

# Google Maps Map ID（Cloud Console → Map management）
GOOGLE_MAP_ID=your_google_map_id_here

# HERE Maps JS API key（developer.here.com → Projects → REST API key）
# Google Maps 超限時的 fallback provider
HERE_API_KEY=your_here_api_key_here

# Google Places API server key（只供本機檢核工具使用，不可放進前端）
GOOGLE_PLACE_KEY=your_google_places_server_key_here

# Notion internal integration token（integration 只分享 Locations (PoC)）
NOTION_API_KEY=your_notion_integration_token_here

# 正式 Locations 對帳專用 Notion token：
# integration 只能有 Read content capability，且只分享正式 Locations。
# 也供 locations:export:notion 讀取正式資料並產生候選 snapshot。
# 不得沿用或擴大上方 PoC integration 的權限。
NOTION_FORMAL_READ_API_KEY=your_formal_locations_read_only_token_here

# 正式 Locations 寫入專用 token：
# 只供另行核准且帶明確 --confirm 的 Phase C production 命令使用；
# 不得沿用 PoC token，read-only preflight 也不得讀取此變數。
# 2026-07-19 正式 schema migration 已核准完成；任何 page write 仍需另行核准。
# NOTION_FORMAL_WRITE_API_KEY=

# 地點資料來源：notion 使用已提交並驗證的 data/locations.csv；
# sheet 是回滾路徑，也是未設定 DATA_SOURCE 時的預設值
DATA_SOURCE=notion

# 僅 DATA_SOURCE=sheet 時需要：Google Sheets 發佈至網路後的 CSV URL
# 只放在 Netlify / 本機環境變數，前端會透過 /api/locations 讀取，不會暴露此網址
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/.../pub?gid=...&single=true&output=csv
