{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/app/app-coordinator.js",
    "src/changelog-page.js",
    "src/core/state.js",
    "src/data/csv-parser.js",
    "src/features/changelog-data.js",
    "src/map/map.js",
    "src/features/forms.js",
    "src/map/map-globals.d.ts"
  ]
}
