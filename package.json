{
  "name": "lingorm-bangkok-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "location:verify": "node --env-file-if-exists=.env scripts/location-verification-runner.mjs",
    "location:verify:ui": "node --env-file-if-exists=.env scripts/location-verification-ui-server.mjs",
    "location:verify:formal-ui": "node --env-file-if-exists=.env scripts/location-verification-ui-server.mjs --target formal --formal-workflow --approved-by maintainer",
    "location:cutover:capture": "node --env-file-if-exists=.env scripts/capture-formal-cutover-baseline.mjs",
    "location:formal-schema": "node --env-file-if-exists=.env scripts/migrate-formal-location-schema.mjs",
    "location:formal-canary": "node --env-file-if-exists=.env scripts/initialize-formal-location-canary.mjs",
    "location:formal-queue-preview": "node --env-file-if-exists=.env scripts/preview-formal-review-queue-initialization.mjs",
    "location:formal-queue": "node --env-file-if-exists=.env scripts/initialize-formal-review-queue.mjs",
    "test:location-verification": "node --test tests/formal-canary-initialization.test.mjs tests/formal-cutover-baseline.test.mjs tests/formal-review-queue-initialization.test.mjs tests/formal-review-queue-preview.test.mjs tests/formal-schema-migration.test.mjs tests/location-verification-core.test.mjs tests/location-verification-runner.test.mjs tests/location-verification-ui-server.test.mjs tests/location-verification-validator.test.mjs",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "^2.6.2"
  }
}
